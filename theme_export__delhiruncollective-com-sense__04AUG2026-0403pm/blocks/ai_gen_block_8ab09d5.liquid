{% doc %}
  @prompt
    make a section for show casing two buttons to purse tickets and very small one line description of the catory of the ticket eg - early bird and Standard, put both the tickes in one card and the title can be put directly on the button , use more attractive colors for the buttons and remove caps from catrory name and also mention price , make the clickable button smaller  and wrtie information one one side and make a more strcutreured column view 
    give a tiitle to the card , make the clickable button smaller  and wrtie information one one side and make a more strcutreured column view 
    give a tiitle to the card , give option to remove one ticket category and add more if needed
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ticket-showcase-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-ticket-showcase-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-ticket-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-ticket-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    color: {{ block.settings.card_title_color }};
    text-align: {{ block.settings.card_title_alignment }};
  }

  .ai-ticket-items-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
  }

  .ai-ticket-item-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 20px;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background }};
    border-radius: {{ block.settings.item_border_radius }}px;
    border: 1px solid {{ block.settings.item_border_color }};
  }

  .ai-ticket-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ai-ticket-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_font_size }}px;
    font-weight: 600;
    margin: 0;
    color: {{ block.settings.category_color }};
  }

  .ai-ticket-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    margin: 0;
    line-height: 1.4;
    color: {{ block.settings.description_color }};
    opacity: 0.85;
  }

  .ai-ticket-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    font-weight: 700;
    margin: 0;
    color: {{ block.settings.price_color }};
  }

  .ai-ticket-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    white-space: nowrap;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-ticket-button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(155, 4, 111, 0.3);
  }

  @media screen and (max-width: 749px) {
    .ai-ticket-item-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .ai-ticket-button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-ticket-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ticket-showcase-container-{{ ai_gen_id }}">
    <div class="ai-ticket-card-{{ ai_gen_id }}">
      {% if block.settings.card_title != blank %}
        <h2 class="ai-ticket-card-title-{{ ai_gen_id }}">{{ block.settings.card_title }}</h2>
      {% endif %}

      <div class="ai-ticket-items-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign enabled_key = 'ticket_' | append: i | append: '_enabled'
            assign category_key = 'ticket_' | append: i | append: '_category'
            assign description_key = 'ticket_' | append: i | append: '_description'
            assign price_key = 'ticket_' | append: i | append: '_price'
            assign link_key = 'ticket_' | append: i | append: '_link'
            assign button_text_key = 'ticket_' | append: i | append: '_button_text'

            assign enabled = block.settings[enabled_key]
            assign category = block.settings[category_key]
            assign description = block.settings[description_key]
            assign price = block.settings[price_key]
            assign link = block.settings[link_key]
            assign button_text = block.settings[button_text_key]
          %}

          {% if enabled %}
            <div class="ai-ticket-item-{{ ai_gen_id }}">
              <div class="ai-ticket-info-{{ ai_gen_id }}">
                {% if category != blank %}
                  <h3 class="ai-ticket-category-{{ ai_gen_id }}">{{ category }}</h3>
                {% endif %}
                {% if description != blank %}
                  <p class="ai-ticket-description-{{ ai_gen_id }}">{{ description }}</p>
                {% endif %}
                {% if price != blank %}
                  <p class="ai-ticket-price-{{ ai_gen_id }}">{{ price }}</p>
                {% endif %}
              </div>
              {% if link != blank %}
                <a href="{{ link }}" class="ai-ticket-button-{{ ai_gen_id }}">
                  {% if button_text != blank %}
                    {{ button_text }}
                  {% else %}
                    Buy Now
                  {% endif %}
                </a>
              {% else %}
                <button class="ai-ticket-button-{{ ai_gen_id }}" disabled>
                  {% if button_text != blank %}
                    {{ button_text }}
                  {% else %}
                    Buy Now
                  {% endif %}
                </button>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

