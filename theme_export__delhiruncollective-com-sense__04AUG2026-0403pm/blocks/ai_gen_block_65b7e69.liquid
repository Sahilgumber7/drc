{% doc %}
  @prompt
    Create a bold, energetic announcement section for my Shopify store to promote 
    an upcoming running event called "Mine Crazy 15K".
    
    The section should include:
    
    1. A large, attention-grabbing headline announcing the event name: "Mine Crazy 15K"
    
    2. A short event description paragraph that explains:
       - It's a 15-kilometer running race through mine-themed or rugged terrain
       - It's an adventurous, high-energy challenge for runners of all levels
       - Mention it's an exciting community event (you can leave placeholders for 
         the date, location, and time like [DATE], [LOCATION], [TIME])
    
    3. Key event details displayed as icons or badges:
       - Distance: 15K
       - Date: [EVENT DATE]
       - Location: [VENUE/CITY]
       - Entry fee or any prizes: [PRIZE/FEE]
    
    4. A prominent "Register Now" call-to-action button that links to [REGISTRATION URL]
    
    5. A sense of urgency — something like "Limited spots available!" or 
       "Early bird registration open now!"
    
    Design style:
    - Bold, adventurous, and sporty — use strong contrast, dark background 
      with bright accent colors (orange or yellow work well for energy)
    - Large display typography for the event name
    - The "Register Now" button should stand out clearly — make it a 
      high-contrast color like orange or neon yellow
    - Mobile-friendly layout
    - Optional: Add a background image placeholder for a race/trail photo
    
    Make the section feel exciting and motivating to encourage sign-ups.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-event-announcement-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-event-announcement-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-event-announcement-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-event-announcement-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, {{ block.settings.background_color }} 0%, {{ block.settings.background_gradient_color }} 100%);
  }

  .ai-event-announcement-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.1;
  }

  .ai-event-announcement-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 1;
  }

  .ai-event-announcement-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-event-announcement-urgency-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.urgency_bg_color }};
    color: {{ block.settings.urgency_text_color }};
    padding: 8px 20px;
    border-radius: 50px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 20px;
  }

  .ai-event-announcement-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 800;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .ai-event-announcement-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0 0 40px;
    line-height: 1.6;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-event-announcement-details-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-event-announcement-detail-{{ ai_gen_id }} {
    background-color: {{ block.settings.detail_bg_color }};
    color: {{ block.settings.detail_text_color }};
    padding: 20px 30px;
    border-radius: {{ block.settings.detail_border_radius }}px;
    min-width: 150px;
    flex: 1;
    max-width: 200px;
  }

  .ai-event-announcement-detail-label-{{ ai_gen_id }} {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
    margin-bottom: 8px;
  }

  .ai-event-announcement-detail-value-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 700;
  }

  .ai-event-announcement-cta-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    padding: 18px 50px;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    transition: all 0.3s ease;
    border: 2px solid {{ block.settings.button_bg_color }};
  }

  .ai-event-announcement-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_bg_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-event-announcement-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.6);
    }

    .ai-event-announcement-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.9);
    }

    .ai-event-announcement-details-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-event-announcement-detail-{{ ai_gen_id }} {
      min-width: 120px;
      max-width: 150px;
    }

    .ai-event-announcement-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }
  }
{% endstyle %}

<event-announcement-{{ ai_gen_id }}
  class="ai-event-announcement-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-event-announcement-bg-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-event-announcement-bg-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-event-announcement-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-event-announcement-content-{{ ai_gen_id }}">
    {% if block.settings.show_urgency and block.settings.urgency_text != blank %}
      <div class="ai-event-announcement-urgency-{{ ai_gen_id }}">
        {{ block.settings.urgency_text }}
      </div>
    {% endif %}

    {% if block.settings.event_title != blank %}
      <h1 class="ai-event-announcement-title-{{ ai_gen_id }}">
        {{ block.settings.event_title }}
      </h1>
    {% endif %}

    {% if block.settings.event_description != blank %}
      <div class="ai-event-announcement-description-{{ ai_gen_id }}">
        {{ block.settings.event_description }}
      </div>
    {% endif %}

    <div class="ai-event-announcement-details-{{ ai_gen_id }}">
      {% if block.settings.show_distance and block.settings.distance != blank %}
        <div class="ai-event-announcement-detail-{{ ai_gen_id }}">
          <div class="ai-event-announcement-detail-label-{{ ai_gen_id }}">Distance</div>
          <div class="ai-event-announcement-detail-value-{{ ai_gen_id }}">{{ block.settings.distance }}</div>
        </div>
      {% endif %}

      {% if block.settings.show_date and block.settings.event_date != blank %}
        <div class="ai-event-announcement-detail-{{ ai_gen_id }}">
          <div class="ai-event-announcement-detail-label-{{ ai_gen_id }}">Date</div>
          <div class="ai-event-announcement-detail-value-{{ ai_gen_id }}">{{ block.settings.event_date }}</div>
        </div>
      {% endif %}

      {% if block.settings.show_location and block.settings.event_location != blank %}
        <div class="ai-event-announcement-detail-{{ ai_gen_id }}">
          <div class="ai-event-announcement-detail-label-{{ ai_gen_id }}">Location</div>
          <div class="ai-event-announcement-detail-value-{{ ai_gen_id }}">{{ block.settings.event_location }}</div>
        </div>
      {% endif %}

      {% if block.settings.show_prize and block.settings.prize_fee != blank %}
        <div class="ai-event-announcement-detail-{{ ai_gen_id }}">
          <div class="ai-event-announcement-detail-label-{{ ai_gen_id }}">{{ block.settings.prize_label }}</div>
          <div class="ai-event-announcement-detail-value-{{ ai_gen_id }}">{{ block.settings.prize_fee }}</div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.button_text != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-event-announcement-cta-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</event-announcement-{{ ai_gen_id }}>

<script>
  (function() {
    class EventAnnouncement{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const ctaButton = this.querySelector('.ai-event-announcement-cta-{{ ai_gen_id }}');
        if (ctaButton && !ctaButton.getAttribute('href')) {
          ctaButton.setAttribute('role', 'button');
          ctaButton.setAttribute('tabindex', '0');
        }
      }
    }

    customElements.define('event-announcement-{{ ai_gen_id }}', EventAnnouncement{{ ai_gen_id }});
  })();
</script>

