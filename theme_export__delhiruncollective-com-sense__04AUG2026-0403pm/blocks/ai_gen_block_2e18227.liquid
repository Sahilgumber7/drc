{% doc %}
  @prompt
    Create a clean, modern event sign-up page for Delhi Run Collective using the following structure:
    
    1. Hero Section (Cover Image)
    
    Full-width hero image showcasing the event or Hot Mat Pilates session.
    
    Overlay text:
    Event Title
    Date + Time
    Venue (with clickable link to Google Maps)
    
    Add a primary CTA button: “Book Early Bird Ticket” (scrolls to ticket section)
    
    2. Event Description
    
    Write a short, premium description of the event, explaining:
    
    What the session is
    
    Who it’s for
    
    What participants get
    
    Why it’s valuable for runners (core strength, mobility, recovery, etc.)
    Tone should be clean, energetic, and community-focused.
    
    3. Ticket Options (Two-Tier)
    
    Display two selectable ticket cards:
    
    A. Early Bird Ticket
    
    CTA: “Buy Early Bird”
    
    Short description (example):
    “Discounted pricing for early sign-ups. Includes full class access and a brewed coffee before the session.”
    
    B. Standard Ticket
    
    CTA: “Buy Standard Ticket”
    
    Short description (example):
    “General admission for the session. Includes full class access and community perks.”
    
    Make the Early Bird card visually highlighted.
    
    4. Event Details Section
    
    Include:
    
    Date & Time
    
    Venue Name
    
    Address
    
    Clickable Google Maps link
    
    What to bring (e.g., yoga mat)
    
    What’s included (e.g., coffee)
    
    Keep this section styled clean and minimal.
    
    5. Image Gallery
    
    Add a grid or carousel of 4–6 images showcasing:
    
    Previous DRC events
    
    Community shots
    
    Pilates/running sessions
    Use a layout similar to Lumas: clean, spaced, high-impact visuals.
    
    6. Host & Partner Section (Optional)
    
    Logos or small descriptions of:
    
    Delhi Run Collective
    
    Banana Burn
    
    YellowStripe Dance Co.
    
    7. Final CTA Section
    
    Repeat the CTA to convert users:
    
    Large button: “Get Tickets”
    
    Small reminder text:
    “Limited spots — secure your mat now.”, decrease the font size and fit more items on screen, make the images a crousel scroll, make it optimal for mobile , put both the tickets in one box so visibility is clear 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-event-page-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-event-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 500px;
    overflow: hidden;
  }

  .ai-event-hero-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-event-hero-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-event-hero-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 600px;
  }

  .ai-event-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.6) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-event-hero-content-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.hero_text_color }};
    max-width: 800px;
    padding: 20px;
  }

  .ai-event-hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_title_size }}px;
    font-weight: 600;
    margin: 0 0 20px;
    line-height: 1.2;
  }

  .ai-event-hero-details-{{ ai_gen_id }} {
    font-size: {{ block.settings.hero_details_size }}px;
    margin-bottom: 30px;
    line-height: 1.6;
  }

  .ai-event-hero-detail-{{ ai_gen_id }} {
    display: inline-block;
    margin: 0 15px;
  }

  .ai-event-hero-venue-link-{{ ai_gen_id }} {
    color: {{ block.settings.hero_text_color }};
    text-decoration: underline;
  }

  .ai-event-hero-venue-link-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-event-hero-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 40px;
    background-color: {{ block.settings.hero_cta_bg }};
    color: {{ block.settings.hero_cta_text }};
    text-decoration: none;
    border-radius: 10px;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: transform 0.2s ease;
  }

  .ai-event-hero-cta-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    background-color: {{ block.settings.hero_cta_hover_bg }};
  }

  .ai-event-section-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: {{ block.settings.section_spacing }}px 20px;
  }

  .ai-event-description-{{ ai_gen_id }} {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-event-description-{{ ai_gen_id }} h2 {
    font-size: 36px;
    margin-bottom: 20px;
    color: {{ block.settings.text_color }};
  }

  .ai-event-description-{{ ai_gen_id }} p {
    font-size: 18px;
    line-height: 1.8;
    color: {{ block.settings.text_color }};
    margin-bottom: 15px;
  }

  .ai-event-tickets-{{ ai_gen_id }} {
    background-color: {{ block.settings.tickets_bg_color }};
    padding: {{ block.settings.section_spacing }}px 20px;
  }

  .ai-event-tickets-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: 36px;
    margin-bottom: 40px;
    color: {{ block.settings.text_color }};
  }

  .ai-event-tickets-container-{{ ai_gen_id }} {
    max-width: 900px;
    margin: 0 auto;
    background-color: {{ block.settings.ticket_card_bg }};
    border-radius: 16px;
    padding: 40px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  .ai-event-tickets-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .ai-event-ticket-card-{{ ai_gen_id }} {
    padding: 30px 24px;
    text-align: center;
    border-radius: 12px;
    border: 2px solid #e5e5e5;
    transition: all 0.3s ease;
    position: relative;
  }

  .ai-event-ticket-card-{{ ai_gen_id }}:hover {
    transform: translateY(-3px);
    border-color: {{ block.settings.early_bird_highlight }};
  }

  .ai-event-ticket-card-{{ ai_gen_id }}.highlighted {
    border-color: {{ block.settings.early_bird_highlight }};
    background-color: rgba(155, 4, 111, 0.03);
  }

  .ai-event-ticket-badge-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.early_bird_highlight }};
    color: #ffffff;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 15px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-event-ticket-name-{{ ai_gen_id }} {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 12px;
    color: {{ block.settings.text_color }};
  }

  .ai-event-ticket-price-{{ ai_gen_id }} {
    font-size: 38px;
    font-weight: 700;
    margin-bottom: 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-event-ticket-description-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 24px;
    color: {{ block.settings.text_color }};
    opacity: 0.85;
    min-height: 80px;
  }

  .ai-event-ticket-cta-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 28px;
    background-color: {{ block.settings.ticket_cta_bg }};
    color: {{ block.settings.ticket_cta_text }};
    text-decoration: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    transition: all 0.2s ease;
    width: 100%;
    max-width: 200px;
  }

  .ai-event-ticket-cta-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    background-color: {{ block.settings.ticket_cta_hover_bg }};
  }

  .ai-event-tickets-divider-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-event-tickets-divider-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 1px;
    height: 80%;
    background: linear-gradient(to bottom, transparent, #e5e5e5 20%, #e5e5e5 80%, transparent);
    transform: translateY(-50%);
  }

  .ai-event-tickets-divider-{{ ai_gen_id }}::after {
    content: 'OR';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: {{ block.settings.ticket_card_bg }};
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    opacity: 0.5;
    border-radius: 20px;
  }

  .ai-event-details-{{ ai_gen_id }} {
    background-color: {{ block.settings.details_bg_color }};
    padding: {{ block.settings.section_spacing }}px 20px;
  }

  .ai-event-details-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: 36px;
    margin-bottom: 40px;
    color: {{ block.settings.text_color }};
  }

  .ai-event-details-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .ai-event-detail-item-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-event-detail-label-{{ ai_gen_id }} {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin-bottom: 10px;
  }

  .ai-event-detail-value-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
  }

  .ai-event-detail-value-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: none;
  }

  .ai-event-detail-value-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  .ai-event-gallery-{{ ai_gen_id }} {
    padding: {{ block.settings.section_spacing }}px 0;
  }

  .ai-event-gallery-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: 36px;
    margin-bottom: 40px;
    color: {{ block.settings.text_color }};
    padding: 0 20px;
  }

  .ai-event-gallery-carousel-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .ai-event-gallery-track-{{ ai_gen_id }} {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0 20px 20px;
  }

  .ai-event-gallery-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-event-gallery-item-{{ ai_gen_id }} {
    flex: 0 0 85%;
    max-width: 500px;
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 4 / 3;
    scroll-snap-align: center;
  }

  .ai-event-gallery-item-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-event-gallery-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-event-gallery-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-event-partners-{{ ai_gen_id }} {
    background-color: {{ block.settings.partners_bg_color }};
    padding: {{ block.settings.section_spacing }}px 20px;
  }

  .ai-event-partners-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: 36px;
    margin-bottom: 40px;
    color: {{ block.settings.text_color }};
  }

  .ai-event-partners-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    max-width: 900px;
    margin: 0 auto;
    align-items: center;
  }

  .ai-event-partner-item-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-event-partner-logo-{{ ai_gen_id }} {
    max-width: 150px;
    height: auto;
    margin: 0 auto 15px;
    display: block;
  }

  .ai-event-partner-name-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin-bottom: 10px;
  }

  .ai-event-partner-description-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    line-height: 1.6;
  }

  .ai-event-final-cta-{{ ai_gen_id }} {
    background-color: {{ block.settings.final_cta_bg }};
    padding: {{ block.settings.section_spacing }}px 20px;
    text-align: center;
  }

  .ai-event-final-cta-content-{{ ai_gen_id }} {
    max-width: 600px;
    margin: 0 auto;
  }

  .ai-event-final-cta-title-{{ ai_gen_id }} {
    font-size: 42px;
    font-weight: 700;
    margin-bottom: 20px;
    color: {{ block.settings.final_cta_text_color }};
  }

  .ai-event-final-cta-subtitle-{{ ai_gen_id }} {
    font-size: 18px;
    margin-bottom: 30px;
    color: {{ block.settings.final_cta_text_color }};
    opacity: 0.9;
  }

  .ai-event-final-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 18px 50px;
    background-color: {{ block.settings.final_cta_button_bg }};
    color: {{ block.settings.final_cta_button_text }};
    text-decoration: none;
    border-radius: 10px;
    font-size: 20px;
    font-weight: 600;
    transition: transform 0.2s ease;
  }

  .ai-event-final-cta-button-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    background-color: {{ block.settings.final_cta_button_hover_bg }};
  }

  @media screen and (max-width: 768px) {
    .ai-event-hero-{{ ai_gen_id }} {
      height: 50vh;
      min-height: 350px;
    }

    .ai-event-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_hero_title_size }}px;
      margin-bottom: 12px;
    }

    .ai-event-hero-details-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_hero_details_size }}px;
      margin-bottom: 20px;
    }

    .ai-event-hero-detail-{{ ai_gen_id }} {
      display: block;
      margin: 8px 0;
    }

    .ai-event-hero-cta-{{ ai_gen_id }} {
      padding: 12px 28px;
      font-size: 15px;
    }

    .ai-event-section-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_spacing }}px 16px;
    }

    .ai-event-description-{{ ai_gen_id }} h2 {
      font-size: {{ block.settings.mobile_section_title_size }}px;
      margin-bottom: 16px;
    }

    .ai-event-description-{{ ai_gen_id }} p {
      font-size: {{ block.settings.mobile_body_text_size }}px;
      line-height: 1.6;
      margin-bottom: 12px;
    }

    .ai-event-tickets-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_spacing }}px 16px;
    }

    .ai-event-tickets-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_section_title_size }}px;
      margin-bottom: 24px;
    }

    .ai-event-tickets-container-{{ ai_gen_id }} {
      padding: 24px 16px;
      border-radius: 12px;
    }

    .ai-event-tickets-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-event-tickets-divider-{{ ai_gen_id }}::before {
      width: 80%;
      height: 1px;
      left: 50%;
      transform: translateX(-50%);
      background: linear-gradient(to right, transparent, #e5e5e5 20%, #e5e5e5 80%, transparent);
    }

    .ai-event-ticket-card-{{ ai_gen_id }} {
      padding: 24px 16px;
    }

    .ai-event-ticket-name-{{ ai_gen_id }} {
      font-size: 20px;
      margin-bottom: 10px;
    }

    .ai-event-ticket-price-{{ ai_gen_id }} {
      font-size: 30px;
      margin-bottom: 14px;
    }

    .ai-event-ticket-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_body_text_size }}px;
      margin-bottom: 20px;
      min-height: auto;
    }

    .ai-event-ticket-cta-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 14px;
      max-width: 100%;
    }

    .ai-event-details-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_spacing }}px 16px;
    }

    .ai-event-details-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_section_title_size }}px;
      margin-bottom: 24px;
    }

    .ai-event-details-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .ai-event-detail-label-{{ ai_gen_id }} {
      font-size: 11px;
      margin-bottom: 6px;
    }

    .ai-event-detail-value-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_body_text_size }}px;
      line-height: 1.5;
    }

    .ai-event-gallery-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_spacing }}px 0;
    }

    .ai-event-gallery-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_section_title_size }}px;
      margin-bottom: 24px;
      padding: 0 16px;
    }

    .ai-event-gallery-track-{{ ai_gen_id }} {
      padding: 0 16px 16px;
      gap: 16px;
    }

    .ai-event-gallery-item-{{ ai_gen_id }} {
      flex: 0 0 90%;
    }

    .ai-event-partners-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_spacing }}px 16px;
    }

    .ai-event-partners-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_section_title_size }}px;
      margin-bottom: 24px;
    }

    .ai-event-partners-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .ai-event-partner-logo-{{ ai_gen_id }} {
      max-width: 120px;
    }

    .ai-event-partner-name-{{ ai_gen_id }} {
      font-size: 16px;
      margin-bottom: 8px;
    }

    .ai-event-partner-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_body_text_size }}px;
    }

    .ai-event-final-cta-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_section_spacing }}px 16px;
    }

    .ai-event-final-cta-title-{{ ai_gen_id }} {
      font-size: 28px;
      margin-bottom: 16px;
    }

    .ai-event-final-cta-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_body_text_size }}px;
      margin-bottom: 24px;
    }

    .ai-event-final-cta-button-{{ ai_gen_id }} {
      padding: 14px 36px;
      font-size: 16px;
    }
  }

  @media screen and (min-width: 769px) {
    .ai-event-gallery-track-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      overflow-x: visible;
      padding: 0 20px;
    }

    .ai-event-gallery-item-{{ ai_gen_id }} {
      flex: none;
      max-width: none;
    }
  }
{% endstyle %}

<div class="ai-event-page-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-event-hero-{{ ai_gen_id }}">
    {% if block.settings.hero_image %}
      <img
        src="{{ block.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ block.settings.hero_image.alt | escape }}"
        loading="eager"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
        class="ai-event-hero-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-event-hero-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
    <div class="ai-event-hero-overlay-{{ ai_gen_id }}">
      <div class="ai-event-hero-content-{{ ai_gen_id }}">
        <h1 class="ai-event-hero-title-{{ ai_gen_id }}">{{ block.settings.event_title }}</h1>
        <div class="ai-event-hero-details-{{ ai_gen_id }}">
          <span class="ai-event-hero-detail-{{ ai_gen_id }}">{{ block.settings.event_date_time }}</span>
          <span class="ai-event-hero-detail-{{ ai_gen_id }}">
            {% if block.settings.venue_maps_link != blank %}
              <a href="{{ block.settings.venue_maps_link }}" target="_blank" class="ai-event-hero-venue-link-{{ ai_gen_id }}">
                {{ block.settings.event_venue }}
              </a>
            {% else %}
              {{ block.settings.event_venue }}
            {% endif %}
          </span>
        </div>
        <button class="ai-event-hero-cta-{{ ai_gen_id }}" onclick="document.getElementById('tickets-{{ ai_gen_id }}').scrollIntoView({behavior: 'smooth'})">
          {{ block.settings.hero_cta_label }}
        </button>
      </div>
    </div>
  </div>

  <div class="ai-event-section-{{ ai_gen_id }} ai-event-description-{{ ai_gen_id }}">
    <h2>{{ block.settings.description_title }}</h2>
    <div>{{ block.settings.description_content }}</div>
  </div>

  <div id="tickets-{{ ai_gen_id }}" class="ai-event-tickets-{{ ai_gen_id }}">
    <h2 class="ai-event-tickets-title-{{ ai_gen_id }}">{{ block.settings.tickets_title }}</h2>
    <div class="ai-event-tickets-container-{{ ai_gen_id }}">
      <div class="ai-event-tickets-grid-{{ ai_gen_id }}">
        <div class="ai-event-ticket-card-{{ ai_gen_id }} highlighted">
          {% if block.settings.show_early_bird_badge %}
            <span class="ai-event-ticket-badge-{{ ai_gen_id }}">{{ block.settings.early_bird_badge_text }}</span>
          {% endif %}
          <h3 class="ai-event-ticket-name-{{ ai_gen_id }}">{{ block.settings.early_bird_name }}</h3>
          <div class="ai-event-ticket-price-{{ ai_gen_id }}">{{ block.settings.early_bird_price }}</div>
          <div class="ai-event-ticket-description-{{ ai_gen_id }}">{{ block.settings.early_bird_description }}</div>
          <a href="{{ block.settings.early_bird_link }}" class="ai-event-ticket-cta-{{ ai_gen_id }}">
            {{ block.settings.early_bird_cta }}
          </a>
        </div>

        <div class="ai-event-tickets-divider-{{ ai_gen_id }}"></div>

        <div class="ai-event-ticket-card-{{ ai_gen_id }}">
          <h3 class="ai-event-ticket-name-{{ ai_gen_id }}">{{ block.settings.standard_name }}</h3>
          <div class="ai-event-ticket-price-{{ ai_gen_id }}">{{ block.settings.standard_price }}</div>
          <div class="ai-event-ticket-description-{{ ai_gen_id }}">{{ block.settings.standard_description }}</div>
          <a href="{{ block.settings.standard_link }}" class="ai-event-ticket-cta-{{ ai_gen_id }}">
            {{ block.settings.standard_cta }}
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="ai-event-section-{{ ai_gen_id }} ai-event-details-{{ ai_gen_id }}">
    <h2 class="ai-event-details-title-{{ ai_gen_id }}">{{ block.settings.details_title }}</h2>
    <div class="ai-event-details-grid-{{ ai_gen_id }}">
      <div class="ai-event-detail-item-{{ ai_gen_id }}">
        <div class="ai-event-detail-label-{{ ai_gen_id }}">Date & Time</div>
        <div class="ai-event-detail-value-{{ ai_gen_id }}">{{ block.settings.detail_date_time }}</div>
      </div>
      <div class="ai-event-detail-item-{{ ai_gen_id }}">
        <div class="ai-event-detail-label-{{ ai_gen_id }}">Venue</div>
        <div class="ai-event-detail-value-{{ ai_gen_id }}">
          {{ block.settings.detail_venue_name }}<br>
          {% if block.settings.detail_venue_maps != blank %}
            <a href="{{ block.settings.detail_venue_maps }}" target="_blank">{{ block.settings.detail_venue_address }}</a>
          {% else %}
            {{ block.settings.detail_venue_address }}
          {% endif %}
        </div>
      </div>
      <div class="ai-event-detail-item-{{ ai_gen_id }}">
        <div class="ai-event-detail-label-{{ ai_gen_id }}">What to Bring</div>
        <div class="ai-event-detail-value-{{ ai_gen_id }}">{{ block.settings.detail_what_to_bring }}</div>
      </div>
      <div class="ai-event-detail-item-{{ ai_gen_id }}">
        <div class="ai-event-detail-label-{{ ai_gen_id }}">What's Included</div>
        <div class="ai-event-detail-value-{{ ai_gen_id }}">{{ block.settings.detail_whats_included }}</div>
      </div>
    </div>
  </div>

  {% if block.settings.show_gallery %}
    <div class="ai-event-gallery-{{ ai_gen_id }}">
      <h2 class="ai-event-gallery-title-{{ ai_gen_id }}">{{ block.settings.gallery_title }}</h2>
      <div class="ai-event-gallery-carousel-{{ ai_gen_id }}">
        <div class="ai-event-gallery-track-{{ ai_gen_id }}">
          {% for i in (1..6) %}
            {% assign image_key = 'gallery_image_' | append: i %}
            {% assign image = block.settings[image_key] %}
            <div class="ai-event-gallery-item-{{ ai_gen_id }}">
              {% if image %}
                <img
                  src="{{ image | image_url: width: 600 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="450"
                >
              {% else %}
                <div class="ai-event-gallery-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  {% if block.settings.show_partners %}
    <div class="ai-event-partners-{{ ai_gen_id }}">
      <h2 class="ai-event-partners-title-{{ ai_gen_id }}">{{ block.settings.partners_title }}</h2>
      <div class="ai-event-partners-grid-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign logo_key = 'partner_' | append: i | append: '_logo'
            assign name_key = 'partner_' | append: i | append: '_name'
            assign desc_key = 'partner_' | append: i | append: '_description'
            assign logo = block.settings[logo_key]
            assign name = block.settings[name_key]
            assign description = block.settings[desc_key]
          %}
          {% if name != blank %}
            <div class="ai-event-partner-item-{{ ai_gen_id }}">
              {% if logo %}
                <img src="{{ logo | image_url: width: 300 }}" alt="{{ name | escape }}" class="ai-event-partner-logo-{{ ai_gen_id }}" loading="lazy">
              {% endif %}
              <div class="ai-event-partner-name-{{ ai_gen_id }}">{{ name }}</div>
              {% if description != blank %}
                <div class="ai-event-partner-description-{{ ai_gen_id }}">{{ description }}</div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="ai-event-final-cta-{{ ai_gen_id }}">
    <div class="ai-event-final-cta-content-{{ ai_gen_id }}">
      <h2 class="ai-event-final-cta-title-{{ ai_gen_id }}">{{ block.settings.final_cta_title }}</h2>
      <p class="ai-event-final-cta-subtitle-{{ ai_gen_id }}">{{ block.settings.final_cta_subtitle }}</p>
      <a href="{{ block.settings.final_cta_link }}" class="ai-event-final-cta-button-{{ ai_gen_id }}">
        {{ block.settings.final_cta_btn_label }}
      </a>
    </div>
  </div>
</div>

